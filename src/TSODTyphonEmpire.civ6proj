  <Import Project="$(MSBuildLocalExtensionPath)Civ6.targets" />
  <!--
    Restores after build the BLP entries that the cooker cannot resolve (same as Cecil).

    AssetCooker only looks up assets in projects that really have a pantry directory in the SDK Assets,
    and it ships with only five of them: Civ6 / Shared / Expansion1 / Expansion2 / CivRoyaleScenario.
    When the Mage Tower references DIS_CMP_Alchemical from the Ethiopia Pack, the cooker reports no error; it silently replaces
    m_EntryName with TB_ERROR, so the model is missing in-game.
    At runtime this limit does not apply: players with that DLC installed load its BLP packages as usual.

    Attached with AfterTargets="Build": ReBuild and Default both depend on Build,
    so both command-line builds and ModBuddy's GUI build trigger it.
  -->
  <!-- Skip while no ArtDef exists yet (phase 1 is data only), so the script does not warn that the directory is missing. -->
  <Target Name="TSODRestoreCookedEntries" AfterTargets="Build" Condition="Exists('$(BuildDir)\ArtDefs')">
    <Message Text="还原 cooker 解析不掉的 BLP entry..." Importance="high" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../tools/restore_cooked_entries.py&quot; &quot;$(MSBuildProjectDirectory)/ArtDefs&quot; &quot;$(BuildDir)&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
