<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="12.0" DefaultTargets="Default" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Default</Configuration>
    <Name>LOC_TSOD_TYPHON_EMPIRE_MOD_TITLE</Name>
    <Guid>1e55d0b1-f5d9-48d4-a9b4-32e488b7bf21</Guid>
    <ProjectGuid>b3d032d7-d210-46cf-b0c7-fee28a046eeb</ProjectGuid>
    <ModVersion>1</ModVersion>
    <Teaser>LOC_TSOD_TYPHON_EMPIRE_MOD_TEASER</Teaser>
    <Description>LOC_TSOD_TYPHON_EMPIRE_MOD_DESCRIPTION</Description>
    <AffectsSavedGames>true</AffectsSavedGames>
    <SupportsSinglePlayer>true</SupportsSinglePlayer>
    <SupportsMultiplayer>true</SupportsMultiplayer>
    <SupportsHotSeat>true</SupportsHotSeat>
    <CompatibleVersions>2.0</CompatibleVersions>
    <ActionCriteriaData><![CDATA[<ActionCriteria><Criteria id="TsoDTE_Expansion2"><RuleSetInUse>RULESET_EXPANSION_2</RuleSetInUse></Criteria></ActionCriteria>]]></ActionCriteriaData>
    <InGameActionData><![CDATA[<InGameActions><UpdateDatabase id="TsoDTE_IG_UpdateDatabase" criteria="TsoDTE_Expansion2"><Properties><LoadOrder>100</LoadOrder></Properties></UpdateDatabase><AddGameplayScripts id="TsoDTE_IG_AddGameplayScripts" criteria="TsoDTE_Expansion2"><Properties><LoadOrder>100</LoadOrder></Properties></AddGameplayScripts><UpdateIcons id="TsoDTE_IG_UpdateIcons"><Properties><LoadOrder>100</LoadOrder></Properties></UpdateIcons><UpdateColors id="TsoDTE_IG_UpdateColors"><Properties><LoadOrder>100</LoadOrder></Properties></UpdateColors><UpdateText id="TsoDTE_IG_UpdateText"><Properties><LoadOrder>100</LoadOrder></Properties></UpdateText></InGameActions>]]></InGameActionData>
    <FrontEndActionData><![CDATA[<FrontEndActions><UpdateDatabase id="TsoDTE_FE_UpdateDatabase"><Properties><LoadOrder>100</LoadOrder></Properties></UpdateDatabase><UpdateIcons id="TsoDTE_FE_UpdateIcons"><Properties><LoadOrder>100</LoadOrder></Properties></UpdateIcons><UpdateColors id="TsoDTE_FE_UpdateColors"><Properties><LoadOrder>100</LoadOrder></Properties></UpdateColors><UpdateText id="TsoDTE_FE_UpdateText"><Properties><LoadOrder>100</LoadOrder></Properties></UpdateText></FrontEndActions>]]></FrontEndActionData>
    <LocalizedTextData><![CDATA[<LocalizedText><Text id="LOC_TSOD_TYPHON_EMPIRE_MOD_TITLE"><en_US>[The Sword of Dawn (TSOD)] Typhon Empire Civilization</en_US><zh_Hans_CN>《黎明之剑》提丰帝国文明</zh_Hans_CN></Text><Text id="LOC_TSOD_TYPHON_EMPIRE_MOD_TEASER"><en_US>New Civilization and Leader - Typhon Empire led by Rosetta Augustus, from the web novel The Sword of Dawn.</en_US><zh_Hans_CN>新文明和领袖——罗塞塔·奥古斯都领导的提丰帝国文明</zh_Hans_CN></Text><Text id="LOC_TSOD_TYPHON_EMPIRE_MOD_DESCRIPTION"><en_US>This MOD adds the civilization Typhon Empire from the online novel "The Sword of Dawn", led by Emperor Rosetta Augustus.[NEWLINE][NEWLINE]Requires the Gathering Storm ruleset (and Rise and Fall). The Ethiopia Pack DLC is optional: without it, only the main model of the Mage Tower district is missing.</en_US><zh_Hans_CN>此模组添加了来自网络小说《黎明之剑》的文明“提丰帝国”，领袖为皇帝罗塞塔·奥古斯都。[NEWLINE][NEWLINE]需要《风云变幻》规则集（以及《迭起兴衰》）。《埃塞俄比亚包》为可选：未安装时仅缺少法师塔区域的主体模型。</zh_Hans_CN></Text></LocalizedText>]]></LocalizedTextData>
    <AssemblyName>TSODTyphonEmpire</AssemblyName>
    <RootNamespace>TSODTyphonEmpire</RootNamespace>
    <Authors>Brus Gwyn Fuchkyo</Authors>
    <AssociationData><![CDATA[<Associations>
  <Dependency type="Dlc" title="Expansion: Gathering Storm" id="4873eb62-8ccc-4574-b784-dda455e74e68" />
  <Dependency type="Dlc" title="Expansion: Rise and Fall" id="1B28771A-C749-434B-9053-D1380C553DE9" />
</Associations>]]></AssociationData>
    <SpecialThanks>
    </SpecialThanks>
    <Homepage>
    </Homepage>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)' == 'Default' ">
    <OutputPath>.</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Folder Include="ArtDefs\" />
    <Folder Include="Core\" />
    <Folder Include="Icons\" />
    <Folder Include="Scripts\" />
    <Folder Include="Texts\" />
    <Folder Include="UI\" />
    <Folder Include="XLPs\" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="TSODTyphonEmpire.Art.xml">
      <SubType>Content</SubType>
    </Content>
  </ItemGroup>
  <Import Project="$(MSBuildLocalExtensionPath)Civ6.targets" />
  <!--
    构建后自动还原 cooker 解析不掉的 BLP entry（照塞西尔）。

    AssetCooker 只在 SDK Assets 里真有 pantry 目录的 project 里查资产，
    而它只带了 Civ6 / Shared / Expansion1 / Expansion2 / CivRoyaleScenario 五份。
    法师塔引用埃塞俄比亚包的 DIS_CMP_Alchemical 时，cooker 不报错，只把
    m_EntryName 悄悄换成 TB_ERROR —— 游戏里的表现就是模型不见了。
    运行时不受这个限制：装了那个 DLC 的玩家，游戏会照常加载它的 BLP 包。

    挂 AfterTargets="Build"，ReBuild 和 Default 都依赖 Build，
    命令行和 ModBuddy 图形界面构建都会触发。
  -->
  <!-- 还没有任何 ArtDef 时（阶段 1 纯数据）跳过，免得脚本找不到目录报警告。 -->
  <Target Name="TSODRestoreCookedEntries" AfterTargets="Build" Condition="Exists('$(BuildDir)\ArtDefs')">
    <Message Text="还原 cooker 解析不掉的 BLP entry..." Importance="high" />
    <Exec Command="python &quot;$(MSBuildProjectDirectory)/../tools/restore_cooked_entries.py&quot; &quot;$(MSBuildProjectDirectory)/ArtDefs&quot; &quot;$(BuildDir)&quot;"
          ContinueOnError="WarnAndContinue" />
  </Target>
</Project>
